{
  "name": "tsi-forms-staging",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"ENVIRONMENT": "staging", "ACCESS_TEAM_DOMAIN": "UNCONFIGURED", "ACCESS_AUD": "UNCONFIGURED"}
  // Bind DB to an independently restored staging D1, PHOTOS to a private staging R2.
  // No production resource bindings are intentionally present.
}
